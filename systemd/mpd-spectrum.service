[Unit]
Description=MPD spectrum bridge for web client
After=network-online.target sound.target mpd.service
Wants=network-online.target

[Service]
Type=simple
User=dlx
Group=dlx
WorkingDirectory=/opt/mpd-web
Environment=MPD_SPECTRUM_HOST=127.0.0.1
Environment=MPD_SPECTRUM_PORT=44883
Environment=MPD_SPECTRUM_BARS=30
Environment=MPD_SPECTRUM_FRAMERATE=60
Environment=MPD_SPECTRUM_INPUT_METHOD=fifo
Environment=MPD_SPECTRUM_SOURCE=/tmp/mpd-cava.fifo
Environment=MPD_SPECTRUM_SAMPLE_RATE=44100
Environment=MPD_SPECTRUM_SAMPLE_BITS=16
Environment=MPD_SPECTRUM_CHANNELS=2
Environment=MPD_SPECTRUM_USE_USER_CONFIG=1
ExecStart=/usr/bin/python3 /opt/mpd-web/mpd-spectrum.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
